# In Streamlit Community Cloud: App -> Settings -> Secrets, paste this with YOUR values.
# On your own computer: save as .streamlit/secrets.toml. NEVER commit the real file to GitHub.
ADMIN_PIN    = "choose-a-long-passphrase-12+chars"      # organiser password, at least 12 characters
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "PASTE-THE-SECRET-OR-SERVICE_ROLE-KEY"   # Supabase -> Project Settings -> API Keys: the SECRET key
